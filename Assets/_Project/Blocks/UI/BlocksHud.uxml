<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="BlocksHud.uss" />
    <ui:VisualElement name="hud-root" picking-mode="Ignore" class="hud-root">
        <ui:VisualElement name="stats" picking-mode="Ignore" class="hud-stats">
            <ui:Label text="LINES" class="hud-caption" />
            <ui:Label text="0" name="lines-value" class="hud-value" />
        </ui:VisualElement>
        <ui:VisualElement name="game-over" picking-mode="Ignore" class="hud-game-over">
            <ui:Label text="GAME OVER" class="hud-game-over-title" />
            <ui:VisualElement picking-mode="Ignore" class="hud-game-over-row">
                <ui:Label text="Lines" class="hud-caption" />
                <ui:Label text="0" name="final-lines" class="hud-value" />
            </ui:VisualElement>
            <ui:Label text="Press R to restart" class="hud-hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
