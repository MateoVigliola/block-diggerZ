.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-stats {
    position: absolute;
    left: 64%;
    top: 8%;
}

.hud-store {
    position: absolute;
    right: 64%;
    top: 8%;
    align-items: flex-end;
}

.hud-store-group {
    align-items: flex-end;
}

.hud-store--locked .hud-store-group {
    opacity: 0.35;
}

.hud-store--locked .hud-timer-group {
    opacity: 1;
}

.hud-root--portrait .hud-store {
    flex-direction: column-reverse;
    justify-content: flex-end;
    align-items: flex-start;
}

.hud-root--portrait .hud-store-group {
    align-items: flex-start;
}

.hud-root--portrait .hud-store-caption {
    margin-top: 0;
}

.hud-root--portrait .hud-timer-group {
    margin-top: 16px;
}

.hud-root--portrait .hud-stats {
    align-items: flex-end;
}

.hud-root--portrait .hud-key-hint {
    display: none;
}

.hud-root--portrait .hud-hint {
    display: none;
}

.hud-next-caption {
    margin-top: 24px;
}

.hud-store-caption {
    margin-top: 24px;
}

.hud-win-title {
    color: rgb(120, 230, 140);
}

.hud-win-buttons {
    flex-direction: row;
    margin-top: 40px;
}

.hud-win-button {
    min-width: 240px;
    height: 72px;
    margin-left: 16px;
    margin-right: 16px;
    font-size: 32px;
    color: rgb(240, 240, 250);
    background-color: rgb(45, 45, 60);
    border-width: 2px;
    border-color: rgb(90, 90, 110);
    border-radius: 6px;
}

.hud-win-button:hover {
    background-color: rgb(70, 70, 95);
}

.hud-win-button:focus {
    border-color: rgb(120, 230, 140);
}

.hud-piece-box {
    position: relative;
    width: 128px;
    height: 128px;
    margin-top: 8px;
    background-color: rgba(30, 30, 40, 0.6);
    border-width: 1px;
    border-color: rgb(60, 60, 75);
}

.hud-piece-cell {
    position: absolute;
    background-image: url("project://database/Assets/_Project/Blocks/Art/BlockCell.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-key-hint {
    margin-top: 8px;
    font-size: 24px;
    color: rgb(200, 200, 215);
}

.hud-caption {
    font-size: 28px;
    color: rgb(170, 170, 190);
}

.hud-value {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(240, 240, 250);
}

.hud-level-intro {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

.hud-level-intro-text {
    font-size: 96px;
    -unity-font-style: bold;
    color: rgb(240, 200, 120);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(20, 15, 10);
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.6);
}

.hud-game-over {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.65);
    display: none;
}

.hud-game-over-title {
    font-size: 96px;
    -unity-font-style: bold;
    color: rgb(255, 90, 90);
}

.hud-game-over-row {
    flex-direction: row;
    align-items: center;
}

.hud-game-over-row .hud-value {
    margin-left: 16px;
}

.hud-hint {
    margin-top: 24px;
    font-size: 32px;
    color: rgb(220, 220, 230);
}
