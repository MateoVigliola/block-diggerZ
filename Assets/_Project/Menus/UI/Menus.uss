.menu-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.menu-screen--opaque {
    background-color: rgb(10, 10, 14);
}

.menu-screen--dim {
    background-color: rgba(0, 0, 0, 0.7);
}

.menu-page {
    align-items: center;
}

.menu-panel {
    align-items: stretch;
    min-width: 420px;
    padding: 32px;
    background-color: rgba(22, 22, 30, 0.95);
    border-width: 1px;
    border-color: rgb(70, 70, 90);
    border-radius: 6px;
}

.menu-game-title {
    font-size: 72px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 240, 250);
    margin-bottom: 32px;
}

.menu-title {
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 240, 250);
    margin-bottom: 24px;
}

.menu-button {
    height: 64px;
    margin: 8px 0;
    font-size: 30px;
    color: rgb(235, 235, 245);
    background-color: rgb(45, 45, 60);
    border-color: rgb(90, 90, 115);
    border-radius: 4px;
}

.menu-button:hover,
.menu-button:focus {
    background-color: rgb(70, 70, 100);
    border-color: rgb(170, 170, 220);
}

.menu-button--small {
    height: 44px;
    font-size: 22px;
}

.settings-panel {
    width: 900px;
    height: 820px;
}

.settings-tabs {
    flex-direction: row;
    margin-bottom: 16px;
}

.settings-tab {
    flex-grow: 1;
    height: 52px;
    font-size: 26px;
    color: rgb(190, 190, 205);
    background-color: rgb(35, 35, 48);
    border-color: rgb(70, 70, 90);
}

.settings-tab:hover,
.settings-tab:focus {
    border-color: rgb(170, 170, 220);
}

.settings-tab--selected {
    color: rgb(250, 250, 255);
    background-color: rgb(70, 70, 100);
}

.settings-page {
    flex-grow: 1;
}

.settings-hint {
    font-size: 20px;
    color: rgb(160, 160, 180);
    -unity-text-align: middle-center;
    margin: 8px 0;
}

.controls-list {
    flex-grow: 1;
    margin-bottom: 8px;
}

.controls-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
}

.controls-action {
    width: 340px;
    font-size: 24px;
    color: rgb(225, 225, 235);
}

.controls-row--header {
    height: 36px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(90, 90, 115);
    margin-bottom: 6px;
}

.controls-row--header .controls-action,
.controls-column {
    font-size: 18px;
    color: rgb(150, 150, 175);
    -unity-font-style: bold;
}

.controls-column {
    width: 200px;
    margin: 0 6px;
    -unity-text-align: middle-center;
}

.controls-key {
    width: 200px;
    margin: 0 6px;
    height: 44px;
    font-size: 22px;
    color: rgb(235, 235, 245);
    background-color: rgb(45, 45, 60);
    border-color: rgb(90, 90, 115);
}

.controls-key:hover,
.controls-key:focus {
    border-color: rgb(170, 170, 220);
}

.controls-key--empty {
    color: rgb(120, 120, 140);
}

.controls-key--listening {
    background-color: rgb(120, 90, 40);
    border-color: rgb(240, 200, 120);
}

.settings-slider {
    margin: 16px 0;
    font-size: 24px;
}

.settings-slider Label {
    min-width: 200px;
    color: rgb(225, 225, 235);
}
