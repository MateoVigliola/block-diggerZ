.mobile-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
}

.mobile-top-band {
    flex-direction: row;
    flex-shrink: 0;
    height: 440px;
    padding: 16px;
}

.mobile-store-slot {
    width: 240px;
    border-radius: 12px;
}

.mobile-store-slot.mobile-pressed {
    background-color: rgba(255, 255, 255, 0.12);
}

.mobile-top-spacer {
    flex-grow: 1;
}

.mobile-top-right {
    width: 260px;
    align-items: flex-end;
}

.mobile-stats-slot {
    flex-grow: 1;
    align-self: stretch;
    margin-top: 12px;
}

.mobile-board-area {
    flex-grow: 1;
    flex-direction: row;
}

.mobile-tap-zone {
    flex-grow: 1;
    flex-basis: 0;
}

.mobile-tap-zone.mobile-pressed {
    background-color: rgba(255, 255, 255, 0.08);
}

.mobile-gesture-area {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.mobile-gestures .mobile-gesture-area {
    display: flex;
}

.mobile-gestures .mobile-tap-zone {
    display: none;
}

.mobile-gestures .mobile-rotate {
    display: none;
}

.mobile-gestures .mobile-hard-drop {
    margin-left: 0;
    margin-right: 0;
}

.mobile-bottom-row {
    flex-direction: row;
    flex-shrink: 0;
    height: 150px;
    padding: 12px;
}

.mobile-button {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 36px;
    color: rgb(240, 240, 250);
    background-color: rgba(45, 45, 60, 0.85);
    border-width: 2px;
    border-color: rgb(90, 90, 110);
    border-radius: 12px;
}

.mobile-button.mobile-pressed {
    background-color: rgb(85, 85, 115);
    border-color: rgb(120, 230, 140);
}

.mobile-pause {
    width: 110px;
    height: 110px;
    flex-shrink: 0;
    font-size: 48px;
}

.mobile-rotate-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    justify-content: center;
    align-items: center;
    background-color: rgba(10, 10, 18, 0.94);
}

.mobile-rotate-overlay-text {
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(240, 240, 250);
    padding: 32px;
}

.mobile-rotate {
    width: 180px;
}

.mobile-hard-drop {
    flex-grow: 1;
    margin-left: 12px;
    margin-right: 12px;
}
