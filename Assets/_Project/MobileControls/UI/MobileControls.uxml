<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MobileControls.uss" />
    <ui:VisualElement name="mobile-root" picking-mode="Ignore" class="mobile-root">
        <ui:VisualElement name="top-band" picking-mode="Ignore" class="mobile-top-band">
            <ui:VisualElement name="store-slot" class="mobile-store-slot" />
            <ui:VisualElement picking-mode="Ignore" class="mobile-top-spacer" />
            <ui:VisualElement picking-mode="Ignore" class="mobile-top-right">
                <ui:Label text="II" name="pause-button" class="mobile-button mobile-pause" />
                <ui:VisualElement name="stats-slot" picking-mode="Ignore" class="mobile-stats-slot" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="board-area" picking-mode="Ignore" class="mobile-board-area">
            <ui:VisualElement name="move-left" class="mobile-tap-zone" />
            <ui:VisualElement name="move-right" class="mobile-tap-zone" />
        </ui:VisualElement>
        <ui:VisualElement name="bottom-row" picking-mode="Ignore" class="mobile-bottom-row">
            <ui:Label text="CCW" name="rotate-ccw" class="mobile-button mobile-rotate" />
            <ui:Label text="DROP" name="hard-drop" class="mobile-button mobile-hard-drop" />
            <ui:Label text="CW" name="rotate-cw" class="mobile-button mobile-rotate" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="rotate-overlay" class="mobile-rotate-overlay">
        <ui:Label text="Turn your phone upright to play" class="mobile-rotate-overlay-text" />
    </ui:VisualElement>
</ui:UXML>
